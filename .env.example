# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# Discord Bot Token (dari https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application/Client ID
DISCORD_CLIENT_ID=1550548366750912602

# Discord Guild ID (Server ID) - kosongkan jika ingin deploy global
DISCORD_GUILD_ID=1387071872755306637

# ============================================
# BNB CHAIN CONFIGURATION
# ============================================

# Private key wallet bot (tanpa prefix 0x)
# JANGAN bagikan private key ini ke siapapun!
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# BNB Chain RPC URL
# Mainnet: https://bsc-dataseed.binance.org/
# Testnet: https://data-seed-prebsc-1-s1.binance.org:8545/
BNB_RPC_URL=https://bsc-dataseed.binance.org/

# Chain ID
# Mainnet: 56
# Testnet: 97
CHAIN_ID=56

# ============================================
# TOKEN CONTRACT ADDRESSES (BNB Chain Mainnet)
# ============================================

# USDT (Tether USD) - BEP20
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# USDC (USD Coin) - BEP20
USDC_CONTRACT=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# FDUSD (First Digital USD) - BEP20 — pengganti BUSD yang sudah deprecated sejak Feb 2024
FDUSD_CONTRACT=0xc5f0f7b66764F6ec8C8Dff7BA683102295E16409

# WBNB (Wrapped BNB)
WBNB_CONTRACT=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# ============================================
# BOT SETTINGS
# ============================================

# Maksimum jumlah transaksi per user per hari (0 = unlimited)
MAX_TX_PER_DAY=10

# Gas limit default untuk transfer token ERC20
DEFAULT_GAS_LIMIT=100000

# Konfirmasi yang dibutuhkan sebelum transaksi dianggap sukses
REQUIRED_CONFIRMATIONS=3

# Apakah bot berjalan di testnet? (true/false)
IS_TESTNET=false

# ============================================
# BSCSCAN API KEY
# Daftar gratis di https://bscscan.com/register
# lalu buat API key di https://bscscan.com/myapikey
# ============================================
BSCSCAN_API_KEY=your_bscscan_api_key_here
